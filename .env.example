# Modèle de configuration de production (Infomaniak).
# Copier en .env sur le serveur, puis lancer : php artisan key:generate
# Ne jamais versionner le fichier .env.

APP_NAME=Candidatures
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jobs.pierreolliviertissier.ch

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_CH
APP_TIMEZONE=Europe/Zurich

APP_MAINTENANCE_DRIVER=file

# Seul compte autorisé à se connecter.
DASHBOARD_OWNER_EMAIL=
# E-mail d'alerte à chaque connexion réussie.
DASHBOARD_LOGIN_ALERTS=true
# Proxys de confiance, si Infomaniak place un proxy devant le site (sinon laisser vide).
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL/MariaDB créée dans le Manager Infomaniak.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions : chiffrées, cookie HTTPS uniquement, expiration après 60 minutes d'inactivité.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# "lax" et non "strict" : le retour d'autorisation Google (OAuth) en a besoin.
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Envoi des alertes : boîte e-mail Infomaniak (ou SMTP Gmail avec mot de passe d'application).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Connexion Google (Gmail, Drive) : voir docs/google-cloud.md.
# Identifiants d'un client OAuth « Application Web » créé dans Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : par défaut https://<APP_URL>/google/callback
# GOOGLE_REDIRECT_URI=
# Dossier Drive où sont archivées les candidatures envoyées.
GOOGLE_DRIVE_FOLDER=Candidatures
# Registre Google Sheets synchronisé (identifiant présent dans son adresse) et plage lue.
# GOOGLE_REGISTRY_SHEET_ID=
# GOOGLE_REGISTRY_RANGE="Offres!A1:Z1000"
